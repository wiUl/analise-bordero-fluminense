	column 'Tipo de dia'
		lineageTag: 64181a1b-f383-4adf-aeb0-701fdf020e26
		summarizeBy: none
		isNameInferred
		sourceColumn: [Tipo de dia]

		annotation SummarizationSetBy = Automatic

	partition dim_data = calculated
		mode: import
		source =
				
				VAR Inicio = DATE(YEAR(MIN(dim_partida[data])), 1, 1)
				VAR Fim    = DATE(YEAR(MAX(dim_partida[data])), 12, 31)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(Inicio, Fim),
				    "Ano", YEAR([Date]),
				    "Mês nº", MONTH([Date]),
				    "Mês", FORMAT([Date], "mmmm", "pt-BR"),
				    "Trimestre", "T" & QUARTER([Date]),
				    "Dia", DAY([Date]),
				    "Dia da semana nº", WEEKDAY([Date], 2),
				    "Dia da semana", FORMAT([Date], "dddd", "pt-BR"),
				    "Tipo de dia", IF(WEEKDAY([Date], 2) >= 6, "Fim de semana", "Dia Útil")
				)

	annotation PBI_Id = 9fee3677cf01476d8abf01c3dc6cd047

